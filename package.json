{
  "name": "@threadwire/mcp-hub",
  "version": "0.1.0",
  "description": "One endpoint for your whole MCP fleet. Streamable HTTP gateway with auto-discovery, per-tenant RBAC, OAuth PKCE, rate limits, circuit breakers, audit, and token-saving lean tool schemas. Forwards W3C traceparent across upstreams.",
  "author": "threadwire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/threadwire/mcp-hub.git"
  },
  "homepage": "https://github.com/threadwire/mcp-hub",
  "type": "module",
  "bin": {
    "mcp-hub": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "npm run build -s && node --test dist/tests/hub.test.js",
    "start": "node dist/src/cli.js start"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
